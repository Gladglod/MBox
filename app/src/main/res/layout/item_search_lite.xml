<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/vs_4"
    android:layout_marginLeft="@dimen/vs_4"
    android:layout_marginTop="@dimen/vs_4"
    android:layout_marginEnd="@dimen/vs_4"
    android:layout_marginRight="@dimen/vs_4"
    android:layout_marginBottom="@dimen/vs_4"
    android:background="@drawable/bg_phone_card"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_14"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_14"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_18" />
</FrameLayout>
