<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_20">

            <!-- 播放器占位：高度由代码按 16:9 设置 -->
            <View
                android:id="@+id/previewPlayerPlace"
                android:layout_width="match_parent"
                android:layout_height="203dp"
                android:layout_marginStart="-12dp"
                android:layout_marginLeft="-12dp"
                android:layout_marginEnd="-12dp"
                android:layout_marginRight="-12dp"
                android:layout_marginBottom="@dimen/vs_12" />

            <!-- 头部：海报 + 剧名 + 收藏星标（★/☆） + 换源 chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/thumbContainer"
                    android:layout_width="108dp"
                    android:layout_height="162dp"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:background="@drawable/bg_poster"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/ivThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="left"
                            android:maxLines="4"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCollect"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginLeft="6dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="加入收藏"
                            android:gravity="center"
                            android:text="☆"
                            android:textColor="@color/ui_muted"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tvChangeSource"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginLeft="6dp"
                            android:background="@drawable/bg_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="44dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:singleLine="true"
                            android:text="换源"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================ 剧集选择（顶部） ============================ -->

            <!-- 播放源 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridViewFlag"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/vs_12"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- 分集分页（页码）：手机竖屏改为单行横滑，不再分页 -->
            <LinearLayout
                android:id="@+id/mSeriesGroupTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mSeriesGroupView"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <!-- 清晰度 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridViewQuality"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/vs_8"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- 选集标题 + 正序/倒序切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:layout_marginBottom="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="选集"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mSeriesSortTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:text="正序"
                    android:textColor="@color/ui_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 选集：单行横滑 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />

            <!-- ============================ 详情信息（底部，两容器） ============================ -->

            <!-- 容器 A：其他信息（来源/年份常驻；地区/语言/演员/导演/播放链接收进折叠块） -->
            <LinearLayout
                android:id="@+id/detailInfoBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_14"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_6"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/infoMoreBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_6"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_6"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvActor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_6"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDirector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_6"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPlayUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_6"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/ui_text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 其他信息折叠开关：小箭头 + 「详情」，与其余信息分离、独立控制 -->
            <LinearLayout
                android:id="@+id/infoToggleRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/tvInfoToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="详情"
                    android:textColor="@color/ui_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/infoArrowIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="▾"
                    android:textColor="@color/ui_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 容器 B：内容简介（独立容器，自带折叠开关） -->
            <LinearLayout
                android:id="@+id/detailDesBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:orientation="vertical">

                <!-- 简介 -->
                <TextView
                    android:id="@+id/tvDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.25"
                    android:maxLines="3"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="13sp" />

                <!-- 简介折叠开关：小箭头 + 「详情」，点开展开全文，箭头旋转 180° -->
                <LinearLayout
                    android:id="@+id/desToggleRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp"
                    android:paddingRight="8dp"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/tvDesToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="详情"
                        android:textColor="@color/ui_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/desArrowIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="▾"
                        android:textColor="@color/ui_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 播放器：固定在顶部，随内容滚动做位移（全屏时铺满） -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="203dp"
        android:layout_gravity="top"
        android:background="@drawable/preview_player_round"
        android:visibility="gone" />

    <View
        android:id="@+id/previewPlayerBlock"
        android:layout_width="match_parent"
        android:layout_height="203dp"
        android:layout_gravity="top"
        android:background="@drawable/preview_player_block"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mEmptyPlaylist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/vs_128"
            android:layout_height="@dimen/vs_128"
            android:layout_gravity="center"
            android:src="@drawable/icon_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/vs_10"
            android:layout_marginLeft="@dimen/vs_10"
            android:gravity="center"
            android:text="暂无播放数据"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>
</FrameLayout>
