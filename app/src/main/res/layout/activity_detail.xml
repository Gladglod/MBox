<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_20">

            <!-- 播放器占位：高度由代码按 16:9 设置 -->
            <View
                android:id="@+id/previewPlayerPlace"
                android:layout_width="match_parent"
                android:layout_height="203dp"
                android:layout_marginStart="-12dp"
                android:layout_marginLeft="-12dp"
                android:layout_marginEnd="-12dp"
                android:layout_marginRight="-12dp"
                android:layout_marginBottom="@dimen/vs_12" />

            <!-- 头部：左海报（预览开启时隐藏） + 右信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/thumbContainer"
                    android:layout_width="108dp"
                    android:layout_height="162dp"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:background="@drawable/bg_poster"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/ivThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_6"
                        android:ellipsize="end"
                        android:gravity="left"
                        android:maxLines="2"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_6"
                        android:background="@drawable/bg_chip"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/vs_10"
                        android:paddingTop="@dimen/vs_3"
                        android:paddingRight="@dimen/vs_10"
                        android:paddingBottom="@dimen/vs_3"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvSite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_3"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_3"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_3"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_3"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvActor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_3"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/color_CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDirector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/color_CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPlayUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/color_99FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 简介 -->
            <TextView
                android:id="@+id/tvDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.25"
                android:maxLines="3"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="13sp" />

            <!-- 其他操作：一排四个 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCollect"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/vs_6"
                    android:layout_marginRight="@dimen/vs_6"
                    android:layout_weight="1"
                    android:background="@drawable/button_detail_collect"
                    android:gravity="center"
                    android:text="收藏"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvChangeSource"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/vs_6"
                    android:layout_marginRight="@dimen/vs_6"
                    android:layout_weight="1"
                    android:background="@drawable/button_detail_change_source"
                    android:gravity="center"
                    android:text="换源"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvQuickSearch"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/vs_6"
                    android:layout_marginRight="@dimen/vs_6"
                    android:layout_weight="1"
                    android:background="@drawable/button_detail_quick_search"
                    android:gravity="center"
                    android:text="搜索"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_detail_sort"
                    android:gravity="center"
                    android:text="简介"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 播放源 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridViewFlag"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/vs_12"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- 分集分页（页码）：手机竖屏改为单行横滑，不再分页 -->
            <LinearLayout
                android:id="@+id/mSeriesGroupTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mSeriesGroupView"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <!-- 清晰度 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridViewQuality"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/vs_8"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- 选集标题 + 正序/倒序切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_14"
                android:layout_marginBottom="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="选集"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mSeriesSortTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:text="正序"
                    android:textColor="@color/color_02F8E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 选集：单行横滑 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 播放器：固定在顶部，随内容滚动做位移（全屏时铺满） -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="203dp"
        android:layout_gravity="top"
        android:background="@drawable/preview_player_round"
        android:visibility="gone" />

    <View
        android:id="@+id/previewPlayerBlock"
        android:layout_width="match_parent"
        android:layout_height="203dp"
        android:layout_gravity="top"
        android:background="@drawable/preview_player_block"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mEmptyPlaylist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/vs_128"
            android:layout_height="@dimen/vs_128"
            android:layout_gravity="center"
            android:src="@drawable/icon_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/vs_10"
            android:layout_marginLeft="@dimen/vs_10"
            android:gravity="center"
            android:text="暂无播放数据"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>
</FrameLayout>
