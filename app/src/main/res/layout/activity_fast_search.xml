<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 搜索状态 -->
    <TextView
        android:id="@+id/mSearchTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_12"
        android:layout_marginLeft="@dimen/vs_12"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginEnd="@dimen/vs_12"
        android:layout_marginRight="@dimen/vs_12"
        android:background="@drawable/bg_fast_search_status"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lines="2"
        android:maxLines="2"
        android:padding="@dimen/vs_8"
        android:text="准备搜索\n结果 0"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_16" />

    <!-- 分词 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridViewWordFenci"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/vs_6"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:scrollbars="none" />

    <!-- 搜索源过滤 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridViewWord"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/vs_4"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:scrollbars="none" />

    <!-- 搜索结果 -->
    <FrameLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_6"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/vs_8"
            android:scrollbars="none"
            android:visibility="invisible"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridViewFilter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/vs_8"
            android:scrollbars="none"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
