<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部栏：返回 · 搜索状态胶囊 · 筛选（iOS 玻璃钮，按压缩小回弹） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_12"
        android:layout_marginLeft="@dimen/vs_12"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginEnd="@dimen/vs_12"
        android:layout_marginRight="@dimen/vs_12"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivFastSearchBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_card_circle"
            android:clickable="true"
            android:focusable="false"
            android:padding="10dp"
            android:src="@drawable/icon_back"
            android:tint="@color/ui_icon" />

        <TextView
            android:id="@+id/mSearchTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:layout_marginLeft="@dimen/vs_8"
            android:layout_marginEnd="@dimen/vs_8"
            android:layout_marginRight="@dimen/vs_8"
            android:layout_weight="1"
            android:background="@drawable/bg_fast_search_status"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lines="2"
            android:maxLines="2"
            android:padding="@dimen/vs_8"
            android:text="准备搜索\n结果 0"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_16" />

        <ImageView
            android:id="@+id/ivFastSearchFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_card_circle"
            android:clickable="true"
            android:focusable="false"
            android:padding="10dp"
            android:src="@drawable/icon_filter"
            android:tint="@color/ui_accent" />
    </LinearLayout>

    <!-- 分词 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridViewWordFenci"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/vs_6"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:scrollbars="none" />

    <!-- 搜索源过滤 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridViewWord"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/vs_4"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:scrollbars="none" />

    <!-- 搜索结果 -->
    <FrameLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_6"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/vs_8"
            android:scrollbars="none"
            android:visibility="invisible"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridViewFilter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/vs_8"
            android:scrollbars="none"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
