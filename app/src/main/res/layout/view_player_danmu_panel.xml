<?xml version="1.0" encoding="utf-8"?>
<!-- 弹幕设置：与倍速菜单同款透明玻璃面板，弹到「弹」开关上方 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_fan_panel"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="弹幕设置"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <!-- 颜色 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="颜色"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/dm_panel_default"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_chip"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:singleLine="true"
            android:text="默认"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/dm_panel_random"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_chip"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:singleLine="true"
            android:text="随机"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 速度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="速度"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/dm_seek_speed"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="false"
            android:max="100"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progressDrawable="@drawable/bg_danmu_seek"
            android:splitTrack="false"
            android:thumb="@drawable/bg_danmu_seek_thumb" />

        <TextView
            android:id="@+id/dm_val_speed"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="1.5x"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 大小 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="大小"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/dm_seek_size"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="false"
            android:max="14"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progressDrawable="@drawable/bg_danmu_seek"
            android:splitTrack="false"
            android:thumb="@drawable/bg_danmu_seek_thumb" />

        <TextView
            android:id="@+id/dm_val_size"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="8档"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 行数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="行数"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/dm_seek_line"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="false"
            android:max="14"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progressDrawable="@drawable/bg_danmu_seek"
            android:splitTrack="false"
            android:thumb="@drawable/bg_danmu_seek_thumb" />

        <TextView
            android:id="@+id/dm_val_line"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="3行"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 透明度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="透明"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/dm_seek_alpha"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="false"
            android:max="90"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progressDrawable="@drawable/bg_danmu_seek"
            android:splitTrack="false"
            android:thumb="@drawable/bg_danmu_seek_thumb" />

        <TextView
            android:id="@+id/dm_val_alpha"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="90%"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
