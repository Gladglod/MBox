<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="end|center_vertical"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- 卡片宽高在代码里按屏幕尺寸动态计算，这里只做 wrap_content 占位；
         卡片本身 clickable，保证卡片内空白按住不冒泡到根布局的「点空白关窗」 -->
    <LinearLayout
        android:id="@+id/dialog_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_episode_glass"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_glass_card_chip"
                android:clickable="true"
                android:focusable="false"
                android:padding="5dp"
                android:rotation="90"
                android:src="@drawable/ic_player_arrow_down"
                app:tint="@color/ui_text_secondary"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="搜索弹幕"
                android:textColor="@color/ui_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_glass_card_chip"
                android:clickable="true"
                android:focusable="false"
                android:padding="6dp"
                android:src="@drawable/ic_player_close"
                app:tint="@color/ui_text_primary" />
        </LinearLayout>

        <!-- 状态条：显示当前已挂载的弹幕（可卸载）；搜索中/加载中时同一个条切换为进度状态 -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_card_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="6dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/statusProgress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateBehavior="repeat"
                android:indeterminateDrawable="@drawable/anim_loading"
                android:indeterminateOnly="true" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ui_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/statusCancel"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_glass_card_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="卸载"
                android:textColor="@color/ui_accent"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 搜索行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card_chip"
                android:hint="请输入弹幕名称"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingRight="8dp"
                android:singleLine="true"
                android:textColor="@color/ui_text_primary"
                android:textColorHint="@color/ui_text_hint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/inputSubmit"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="搜索"
                android:textColor="@color/ui_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 结果列表：高度在代码里按屏幕计算，避免被截断 -->
        <FrameLayout
            android:id="@+id/list_container"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
