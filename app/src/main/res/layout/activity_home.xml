<?xml version="1.0" encoding="utf-8"?>
<!--
  首页。

  顶栏只承担两件事：搜索、切数据源。
  页面名不放在这里 —— 紧挨着下面的页签条已经在指示"当前在哪一页"，
  再叠一行同样的标题就是重复。
  站点名从"标题"降级进右侧胶囊（它本来也不是标题，是当前数据源）。
  原来那个每秒刷新的时钟已移除（手机状态栏就有时间）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部 App Bar：搜索框 + 数据源胶囊 -->
    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/vs_128"
        android:background="@drawable/bg_appbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_6"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_6">

        <!-- 假输入框：整块可点，点击进搜索页。真输入框留给搜索页，首页不抢键盘 -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/vs_100"
            android:background="@drawable/bg_search_field"
            android:clickable="true"
            android:contentDescription="@string/action_search"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12">

            <ImageView
                android:layout_width="@dimen/vs_40"
                android:layout_height="@dimen/vs_40"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/ui_muted" />

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_8"
                android:layout_marginLeft="@dimen/vs_8"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/search_hint"
                android:textColor="@color/ui_text_hint"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <!-- 当前数据源：点开切换。文字就是站点名，不再是「换源」这种行话 -->
        <TextView
            android:id="@+id/tvMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:layout_marginLeft="@dimen/vs_8"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:drawablePadding="@dimen/vs_4"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxWidth="@dimen/vs_300"
            android:minHeight="@dimen/vs_100"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingEnd="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ui_divider" />

    <!-- 内容区：首页(分类页签 + 列表) 与 分类/我的 片段共用 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 高度不能写死：字号跟随系统后 13sp 可能变成 26sp -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/mTabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/vs_108"
                android:background="@color/ui_surface"
                app:tabIndicatorColor="?attr/colorAccent"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="2dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/ui_text_primary"
                app:tabTextAppearance="@style/TextAppearance.App.Tab"
                app:tabTextColor="@color/ui_text_secondary" />

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/mViewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!--
      底部导航：悬浮胶囊（Liquid Glass）。

      和旧版的三个区别：
      1. 不再紧贴屏幕底边 —— 外层 wrap 加了左右 16dp、下 12dp 的留白，
         让胶囊真的"浮"在页面之上，而不是变成一条贴边的横条；
      2. 背景换成半透明玻璃材质（bg_glass_tabbar），带 1dp 描边和顶部高光；
      3. 选中态不再靠"改文字颜色"表达，而是背后有一枚会滑动的玻璃指示器
         （GlassIndicatorView，弹簧驱动）。文字颜色仍然变，但那是第二层反馈。
    -->
    <FrameLayout
        android:id="@+id/bottomNavWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/vs_24"
        android:paddingLeft="@dimen/vs_24"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_24"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_12">

        <com.github.tvbox.osc.ui.widget.LiquidTabBar
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_162"
            android:background="@drawable/bg_glass_tabbar"
            android:elevation="@dimen/vs_8">

            <!-- 指示器铺满整条，自己按左右边界画胶囊；放在下面 = 在文字图标之后 -->
            <com.github.tvbox.osc.ui.widget.GlassIndicatorView
                android:id="@+id/navIndicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/navItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/nav_home"
                    android:focusable="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavHome"
                        android:layout_width="@dimen/vs_56"
                        android:layout_height="@dimen/vs_56"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_home" />

                    <TextView
                        android:id="@+id/tvNavHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/nav_home"
                        android:textColor="@color/ui_accent"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navDrama"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/nav_short_drama"
                    android:focusable="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavDrama"
                        android:layout_width="@dimen/vs_56"
                        android:layout_height="@dimen/vs_56"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_drama" />

                    <TextView
                        android:id="@+id/tvNavDrama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/nav_short_drama"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navLive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/nav_live"
                    android:focusable="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavLive"
                        android:layout_width="@dimen/vs_56"
                        android:layout_height="@dimen/vs_56"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_live" />

                    <TextView
                        android:id="@+id/tvNavLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/nav_live"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navMine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/nav_mine"
                    android:focusable="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavMine"
                        android:layout_width="@dimen/vs_56"
                        android:layout_height="@dimen/vs_56"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_user" />

                    <TextView
                        android:id="@+id/tvNavMine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/nav_mine"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>
            </LinearLayout>
        </com.github.tvbox.osc.ui.widget.LiquidTabBar>
    </FrameLayout>
</LinearLayout>
