<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:tint="@color/ui_icon"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:text="首页标签"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_6"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_6"
            android:text="保存"
            android:textColor="@color/ui_link"
            android:textSize="@dimen/ts_18"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_16"
        android:layout_marginTop="@dimen/vs_4"
        android:layout_marginRight="@dimen/vs_16"
        android:layout_marginBottom="@dimen/vs_6"
        android:lineSpacingExtra="3dp"
        android:text="勾选决定该分类是否显示在首页，长按可拖动排序。「热门推荐」固定在第 1 位。"
        android:textColor="@color/ui_text_tertiary"
        android:textSize="@dimen/ts_14" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_12"
        android:scrollbars="none" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/ui_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSelectAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="全选"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvSelectNone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="全不选"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvReset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="恢复默认"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</LinearLayout>
