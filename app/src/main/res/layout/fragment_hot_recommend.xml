<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hotGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingRight="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_8"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tvHotEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="暂无推荐内容"
        android:textColor="@color/ui_text_tertiary"
        android:textSize="@dimen/ts_18"
        android:visibility="gone" />
</FrameLayout>
