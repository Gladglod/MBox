<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hotGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingRight="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_8"
        android:scrollbars="none" />

    <!--
      空状态要能指路，不能只是一句陈述。
      文案说清「为什么空」（这个数据源没给推荐），下面给一个能马上做的动作。
    -->
    <LinearLayout
        android:id="@+id/tvHotEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/home_rec_empty"
            android:textColor="@color/ui_text_secondary"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvHotEmptyAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_14"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/vs_108"
            android:paddingStart="@dimen/vs_24"
            android:paddingLeft="@dimen/vs_24"
            android:paddingEnd="@dimen/vs_24"
            android:paddingRight="@dimen/vs_24"
            android:text="@string/home_rec_empty_action"
            android:textColor="@color/ui_accent"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</FrameLayout>
