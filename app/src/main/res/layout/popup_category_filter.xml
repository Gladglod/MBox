<?xml version="1.0" encoding="utf-8"?>
<!-- 贴着首页分类标签展开的细分筛选面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filterPanel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_menu"
    android:orientation="vertical"
    android:paddingStart="@dimen/vs_12"
    android:paddingLeft="@dimen/vs_12"
    android:paddingTop="@dimen/vs_12"
    android:paddingEnd="@dimen/vs_12"
    android:paddingRight="@dimen/vs_12"
    android:paddingBottom="@dimen/vs_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filterTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:paddingStart="@dimen/vs_8"
            android:paddingLeft="@dimen/vs_8"
            android:paddingEnd="@dimen/vs_4"
            android:paddingRight="@dimen/vs_4"
            android:text="@string/home_filter_reset"
            android:textColor="@color/ui_text_secondary"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/filterDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:background="@drawable/bg_filter_done"
        android:clickable="true"
        android:gravity="center"
        android:minHeight="@dimen/vs_45"
        android:text="@string/home_filter_done"
        android:textColor="@color/ui_accent"
        android:textSize="@dimen/ts_16"
        android:textStyle="bold" />

</LinearLayout>
