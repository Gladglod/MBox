<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索弹幕第一层：一部剧 + 一个来源（自适应玻璃行条 + 主题字色） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/groupItem"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_glass_card_chip"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/groupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ui_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/groupMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ui_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/groupArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="@color/ui_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
