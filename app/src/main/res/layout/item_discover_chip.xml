<?xml version="1.0" encoding="utf-8"?>
<!-- 发现页顶部横滑分类胶囊，选中态在代码里切换 bg_chip_selected / bg_chip -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chip"
    android:clickable="true"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center"
    android:maxLines="1"
    android:minHeight="@dimen/vs_100"
    android:paddingStart="@dimen/vs_16"
    android:paddingLeft="@dimen/vs_16"
    android:paddingEnd="@dimen/vs_16"
    android:paddingRight="@dimen/vs_16"
    android:textColor="@color/ui_text_secondary"
    android:textSize="@dimen/ts_16" />
