<?xml version="1.0" encoding="utf-8"?>
<!-- 数据源地址弹窗：手机竖屏，纵向排布（二维码在顶部） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="@dimen/vs_280"
            android:layout_height="@dimen/vs_280"
            android:layout_gravity="center_horizontal"
            android:focusable="false"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_16"
            tools:text="手机/电脑扫描上方二维码或者直接浏览器访问地址" />

        <!-- 配置历史与存储权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/apiHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="历史直播"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18" />

            <TextView
                android:id="@+id/storagePermission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="存储权限"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <!-- 点播地址 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="@dimen/vs_5"
                android:paddingRight="@dimen/vs_5"
                android:text="点播"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18"
                tools:ignore="RtlSymmetry" />

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_dialog_api_input"
                android:hint="请输入配置地址"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusDown="@id/inputLive"
                android:nextFocusForward="@id/inputLive"
                android:paddingLeft="@dimen/vs_8"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_8"
                android:paddingBottom="@dimen/vs_10"
                android:singleLine="true"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/dialog_text_hint"
                android:textSize="@dimen/ts_18" />

            <TextView
                android:id="@+id/inputSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_5"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="选择"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <!-- 直播地址 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="@dimen/vs_5"
                android:paddingRight="@dimen/vs_5"
                android:text="直播"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18"
                tools:ignore="RtlSymmetry" />

            <EditText
                android:id="@+id/inputLive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_dialog_api_input"
                android:hint="请输入直播地址"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusDown="@id/inputConfirm"
                android:nextFocusForward="@id/inputConfirm"
                android:paddingLeft="@dimen/vs_8"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_8"
                android:paddingBottom="@dimen/vs_10"
                android:singleLine="true"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/dialog_text_hint"
                android:textSize="@dimen/ts_18" />

            <TextView
                android:id="@+id/inputSubmitLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_5"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="选择"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <TextView
            android:id="@+id/inputConfirm"
            android:layout_width="@dimen/vs_160"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/vs_16"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_10"
            android:text="确定"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</FrameLayout>
