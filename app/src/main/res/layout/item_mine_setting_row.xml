<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_12"
    android:paddingTop="@dimen/vs_10"
    android:paddingRight="@dimen/vs_12"
    android:paddingBottom="@dimen/vs_10">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvRowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ui_text_secondary"
            android:textSize="@dimen/ts_14"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_10"
        android:maxWidth="180dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ui_text_secondary"
        android:textSize="@dimen/ts_16" />

    <TextView
        android:id="@+id/tvRowArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_6"
        android:text="›"
        android:textColor="@color/ui_text_tertiary"
        android:textSize="@dimen/ts_24" />
</LinearLayout>
