<?xml version="1.0" encoding="utf-8"?>
<!--
  换源：iOS 玻璃质感半屏底部抽屉（与「缓存选集」抽屉同一套设计）。
  根布局铺满（半透明蒙层收点击关闭），抽屉面板贴底、顶部 22dp 大圆角、
  主题自适应玻璃填充（bg_drawer_sheet：日间白玻璃 / 夜间深玻璃），
  高度由代码按屏幕 45% 设定，上半屏保持可见，不遮挡详情页播放预览区。
  内部源列表一行一条（玻璃行条目）：源名 | 片源状态 | 延迟。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_drawer_sheet"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_16"
        android:paddingTop="@dimen/vs_10"
        android:paddingRight="@dimen/vs_16"
        android:paddingBottom="@dimen/vs_14">

        <!-- 抽屉顶部抓手 -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/vs_10"
            android:background="@drawable/bg_glass_pill" />

        <!-- 标题行：换源 · 片名 | 完成 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="换源"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_26"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSourceSpeedSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dialog_text_hint"
                    android:textSize="@dimen/ts_16" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="@dimen/vs_10"
                android:background="@drawable/bg_glass_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingLeft="@dimen/vs_12"
                android:paddingRight="@dimen/vs_12"
                android:text="完成"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="延迟为接口响应耗时，越低越快；「有片源」表示该站搜到本片，点击即切换"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_14" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_weight="1"
            android:overScrollMode="never" />

    </LinearLayout>
</FrameLayout>
