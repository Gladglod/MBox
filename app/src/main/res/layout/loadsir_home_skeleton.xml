<?xml version="1.0" encoding="utf-8"?>
<!--
  首页加载态：海报骨架。

  和真实布局同尺寸 —— 顶部页签条先占好 44dp，下面是三列海报位，
  数据回来后原地替换，不会出现「转圈 → 整块内容突然出现」的跳动。
  纯静态，不做闪光动画：加载通常只有一两百毫秒，动画反而添乱。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical">

    <!-- 页签条占位 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_108"
        android:background="@color/ui_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <View
            android:layout_width="@dimen/vs_56"
            android:layout_height="@dimen/ts_18"
            android:background="@drawable/bg_skeleton_line" />

        <View
            android:layout_width="@dimen/vs_45"
            android:layout_height="@dimen/ts_18"
            android:layout_marginStart="@dimen/vs_24"
            android:layout_marginLeft="@dimen/vs_24"
            android:background="@drawable/bg_skeleton_line" />

        <View
            android:layout_width="@dimen/vs_45"
            android:layout_height="@dimen/ts_18"
            android:layout_marginStart="@dimen/vs_24"
            android:layout_marginLeft="@dimen/vs_24"
            android:background="@drawable/bg_skeleton_line" />

        <View
            android:layout_width="@dimen/vs_45"
            android:layout_height="@dimen/ts_18"
            android:layout_marginStart="@dimen/vs_24"
            android:layout_marginLeft="@dimen/vs_24"
            android:background="@drawable/bg_skeleton_line" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ui_divider" />

    <!-- 海报网格占位：三列，列间 8dp，与 item_grid + SpacesItemDecoration 对齐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_8"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_weight="1" />

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_8"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_weight="1" />

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_14"
            android:orientation="horizontal">

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_8"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_weight="1" />

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_8"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_weight="1" />

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_14"
            android:orientation="horizontal">

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_8"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_weight="1" />

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_8"
                android:layout_marginRight="@dimen/vs_8"
                android:layout_weight="1" />

            <include
                layout="@layout/item_skeleton_poster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
