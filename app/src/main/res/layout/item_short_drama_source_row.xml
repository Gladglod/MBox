<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/vs_140"
    android:orientation="horizontal"
    android:paddingStart="@dimen/vs_12"
    android:paddingLeft="@dimen/vs_12"
    android:paddingTop="@dimen/vs_8"
    android:paddingEnd="@dimen/vs_8"
    android:paddingRight="@dimen/vs_8"
    android:paddingBottom="@dimen/vs_8">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_muted"
            android:textSize="@dimen/ts_14" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="@dimen/vs_12"
        android:contentDescription="@null"
        android:src="@drawable/bg_item_check" />

    <ImageView
        android:id="@+id/ivDel"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/vs_4"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/short_drama_source_remove"
        android:padding="8dp"
        android:src="@drawable/icon_delete"
        android:tint="@color/ui_muted"
        android:visibility="gone" />
</LinearLayout>
