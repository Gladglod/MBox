<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:orientation="vertical"
    android:paddingStart="@dimen/vs_12"
    android:paddingLeft="@dimen/vs_12"
    android:paddingTop="@dimen/vs_12"
    android:paddingEnd="@dimen/vs_12"
    android:paddingRight="@dimen/vs_12"
    android:paddingBottom="@dimen/vs_12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="分类"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_34"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_12"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />
</LinearLayout>
