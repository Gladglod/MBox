<?xml version="1.0" encoding="utf-8"?>
<!--
  发现页（TMDB）。
  结构：顶栏（返回 / 标题 / 搜索 / 设置）→ 媒体类型胶囊 → 类型胶囊 → 海报网格。
  类型胶囊只有「电影 / 剧集 / 高分」需要，「热门」由 trending/all 提供，界面里自动隐藏。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_128"
        android:background="@drawable/bg_appbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_8"
        android:paddingLeft="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_8"
        android:paddingRight="@dimen/vs_8">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/vs_100"
            android:layout_height="@dimen/vs_100"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/discover_title"
            android:focusable="false"
            android:padding="@dimen/vs_12"
            android:src="@drawable/icon_back"
            android:tint="@color/ui_icon" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_4"
            android:layout_marginLeft="@dimen/vs_4"
            android:includeFontPadding="false"
            android:text="@string/discover_title"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_34"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_6"
            android:layout_marginLeft="@dimen/vs_6"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/vs_6"
            android:paddingLeft="@dimen/vs_6"
            android:paddingTop="@dimen/vs_2"
            android:paddingEnd="@dimen/vs_6"
            android:paddingRight="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_2"
            android:text="TMDB"
            android:textColor="@color/ui_accent"
            android:textSize="@dimen/ts_10"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="@dimen/vs_100"
            android:layout_height="@dimen/vs_100"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/discover_search_title"
            android:focusable="false"
            android:padding="@dimen/vs_12"
            android:src="@drawable/ic_search"
            android:tint="@color/ui_icon" />

        <ImageView
            android:id="@+id/ivSettings"
            android:layout_width="@dimen/vs_100"
            android:layout_height="@dimen/vs_100"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/discover_settings_title"
            android:focusable="false"
            android:padding="@dimen/vs_12"
            android:src="@drawable/icon_setting"
            android:tint="@color/ui_icon" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/ui_divider" />

    <!-- 媒体类型：热门 / 电影 / 剧集 / 高分 -->
    <HorizontalScrollView
        android:id="@+id/mediaTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mediaTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_8"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_4" />
    </HorizontalScrollView>

    <!-- 类型胶囊：仅电影 / 剧集 / 高分显示 -->
    <HorizontalScrollView
        android:id="@+id/genreScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/genreChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_2"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_6" />
    </HorizontalScrollView>

    <!-- 搜索结果范围提示 -->
    <TextView
        android:id="@+id/tvScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/vs_16"
        android:paddingLeft="@dimen/vs_16"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_16"
        android:paddingRight="@dimen/vs_16"
        android:paddingBottom="@dimen/vs_8"
        android:textColor="@color/ui_link"
        android:textSize="@dimen/ts_16"
        android:visibility="gone" />

    <!-- 内容区：网格 / 空状态 / 首屏加载叠在同一块区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discoverGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_8"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_8"
            android:scrollbars="none"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/stateLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/stateProgress"
                android:layout_width="@dimen/vs_70"
                android:layout_height="@dimen/vs_70"
                android:indeterminateTint="@color/ui_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_12"
                android:text="@string/discover_state_loading"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/vs_35"
            android:paddingLeft="@dimen/vs_35"
            android:paddingEnd="@dimen/vs_35"
            android:paddingRight="@dimen/vs_35"
            android:visibility="gone">

            <ImageView
                android:id="@+id/stateIcon"
                android:layout_width="@dimen/vs_150"
                android:layout_height="@dimen/vs_150"
                android:background="@drawable/bg_discover_icon_circle"
                android:importantForAccessibility="no"
                android:padding="@dimen/vs_24"
                android:src="@drawable/ic_discover"
                android:tint="@color/ui_accent" />

            <TextView
                android:id="@+id/tvStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:gravity="center"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/ts_24"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStateDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/tvStateAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/vs_100"
                android:paddingStart="@dimen/vs_24"
                android:paddingLeft="@dimen/vs_24"
                android:paddingEnd="@dimen/vs_24"
                android:paddingRight="@dimen/vs_24"
                android:textColor="@color/ui_accent"
                android:textSize="@dimen/ts_18"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 翻页加载更多 -->
    <ProgressBar
        android:id="@+id/loadingMore"
        android:layout_width="@dimen/vs_50"
        android:layout_height="@dimen/vs_50"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/ui_accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAttribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="@dimen/vs_4"
        android:paddingBottom="@dimen/vs_4"
        android:text="@string/discover_attribution"
        android:textColor="@color/ui_text_tertiary"
        android:textSize="@dimen/ts_10" />
</LinearLayout>
