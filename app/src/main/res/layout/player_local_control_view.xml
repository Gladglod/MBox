<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶部：返回 + 标题 -->
    <LinearLayout
        android:id="@+id/localTopBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#59000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <ImageView
            android:id="@+id/ivLocalBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:tint="@android:color/white"
            android:src="@drawable/icon_back" />

        <TextView
            android:id="@+id/tvLocalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/btnLocalSpeed"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/vs_8"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="倍速"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnLocalFull"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/vs_8"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="全屏"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 手势调节时的中央提示（BaseController 驱动） -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:tag="vod_control_slide_info"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 加载中（BaseController 驱动） -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:tag="vod_control_loading"
        android:visibility="gone" />

    <!-- 暂停遮罩（BaseController 驱动：暂停时显示大图标 + 时间） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:clickable="false"
        android:tag="vod_control_pause"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="▶"
            android:textColor="@android:color/white"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="70dp"
            android:tag="vod_control_pause_t"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- 错误重试 -->
    <LinearLayout
        android:id="@+id/localErrorBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#B3000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLocalError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="播放失败，文件可能不完整"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/btnLocalRetry"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="重试"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 底部：播放/暂停 + 进度 + 时间 + 下一集 -->
    <LinearLayout
        android:id="@+id/localBottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#59000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <TextView
            android:id="@+id/btnLocalPlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▶"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLocalPos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_16" />

        <SeekBar
            android:id="@+id/sbLocalProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:layout_marginEnd="@dimen/vs_8"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0" />

        <TextView
            android:id="@+id/tvLocalDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/btnLocalNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/vs_8"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⏭"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
