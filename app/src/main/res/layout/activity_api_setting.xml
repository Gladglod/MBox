<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:tint="@color/ui_icon"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:text="数据源地址"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_6"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_6"
            android:text="保存"
            android:textColor="@color/ui_link"
            android:textSize="@dimen/ts_18"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_30">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_marginTop="@dimen/vs_6"
                android:layout_marginBottom="@dimen/vs_5"
                android:text="当前配置"
                android:textColor="@color/ui_muted"
                android:textSize="@dimen/ts_16" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_phone_card"
                android:orientation="vertical"
                android:padding="@dimen/vs_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="32dp"
                        android:text="点播"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="@dimen/ts_18" />

                    <EditText
                        android:id="@+id/inputApi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="请输入点播配置地址"
                        android:imeOptions="actionNext|flagNoExtractUi"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/vs_8"
                        android:paddingTop="@dimen/vs_8"
                        android:paddingRight="@dimen/vs_8"
                        android:paddingBottom="@dimen/vs_8"
                        android:singleLine="true"
                        android:textColor="@color/ui_text_primary"
                        android:textColorHint="@color/ui_text_hint"
                        android:textSize="@dimen/ts_16" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="32dp"
                        android:text="直播"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="@dimen/ts_18" />

                    <EditText
                        android:id="@+id/inputLive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="留空则与点播一致"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/vs_8"
                        android:paddingTop="@dimen/vs_8"
                        android:paddingRight="@dimen/vs_8"
                        android:paddingBottom="@dimen/vs_8"
                        android:singleLine="true"
                        android:textColor="@color/ui_text_primary"
                        android:textColorHint="@color/ui_text_hint"
                        android:textSize="@dimen/ts_16" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_12"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPickApi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_danmu_setting"
                        android:gravity="center"
                        android:padding="@dimen/vs_10"
                        android:text="本地点播配置"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="@dimen/ts_16" />

                    <TextView
                        android:id="@+id/btnPickLive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vs_8"
                        android:layout_weight="1"
                        android:background="@drawable/button_danmu_setting"
                        android:gravity="center"
                        android:padding="@dimen/vs_10"
                        android:text="本地直播配置"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="@dimen/ts_16" />

                    <TextView
                        android:id="@+id/btnPermission"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vs_8"
                        android:layout_weight="1"
                        android:background="@drawable/button_danmu_setting"
                        android:gravity="center"
                        android:padding="@dimen/vs_10"
                        android:text="存储权限"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="@dimen/ts_16" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_marginTop="@dimen/vs_16"
                android:layout_marginBottom="@dimen/vs_5"
                android:text="短剧"
                android:textColor="@color/ui_muted"
                android:textSize="@dimen/ts_16" />

            <LinearLayout
                android:id="@+id/rowDramaSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_phone_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/vs_140"
                android:orientation="horizontal"
                android:paddingStart="@dimen/vs_12"
                android:paddingLeft="@dimen/vs_12"
                android:paddingTop="@dimen/vs_10"
                android:paddingEnd="@dimen/vs_12"
                android:paddingRight="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_10">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/short_drama_entry_title"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvDramaSourceValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/short_drama_entry_none"
                        android:textColor="@color/ui_muted"
                        android:textSize="@dimen/ts_14" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/vs_8"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ui_muted" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_marginTop="@dimen/vs_16"
                android:layout_marginBottom="@dimen/vs_5"
                android:text="扫码导入"
                android:textColor="@color/ui_muted"
                android:textSize="@dimen/ts_16" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_phone_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/vs_12">

                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@color/ui_chip_bg"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vs_12"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ts_16" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_marginTop="@dimen/vs_16"
                android:layout_marginBottom="@dimen/vs_5"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="历史配置"
                    android:textColor="@color/ui_muted"
                    android:textSize="@dimen/ts_16" />

                <TextView
                    android:id="@+id/tvClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="@dimen/vs_8"
                    android:paddingTop="@dimen/vs_2"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_2"
                    android:text="清空"
                    android:textColor="@color/ui_muted"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_phone_card"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
