<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_12"
    android:paddingTop="@dimen/vs_12"
    android:paddingRight="@dimen/vs_12"
    android:paddingBottom="@dimen/vs_12">

    <LinearLayout
        android:id="@+id/tvUserHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tvHistory"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_weight="1"
                android:layout_margin="@dimen/vs_5"
                android:background="@drawable/bg_phone_card"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_12">

                <ImageView
                    android:layout_width="@dimen/vs_56"
                    android:layout_height="@dimen/vs_56"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:src="@drawable/icon_history" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vs_6"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="历史"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvLive"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_weight="1"
                android:layout_margin="@dimen/vs_5"
                android:background="@drawable/bg_phone_card"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_12">

                <ImageView
                    android:layout_width="@dimen/vs_56"
                    android:layout_height="@dimen/vs_56"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:src="@drawable/icon_live" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vs_6"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="直播"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvSearch"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_weight="1"
                android:layout_margin="@dimen/vs_5"
                android:background="@drawable/bg_phone_card"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_12">

                <ImageView
                    android:layout_width="@dimen/vs_56"
                    android:layout_height="@dimen/vs_56"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:src="@drawable/icon_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vs_6"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="搜索"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tvPush"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_weight="1"
                android:layout_margin="@dimen/vs_5"
                android:background="@drawable/bg_phone_card"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_12">

                <ImageView
                    android:layout_width="@dimen/vs_56"
                    android:layout_height="@dimen/vs_56"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:src="@drawable/icon_push" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vs_6"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="推送"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvFavorite"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_weight="1"
                android:layout_margin="@dimen/vs_5"
                android:background="@drawable/bg_phone_card"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_12">

                <ImageView
                    android:layout_width="@dimen/vs_56"
                    android:layout_height="@dimen/vs_56"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:src="@drawable/icon_collect" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vs_6"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="收藏"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvSetting"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_160"
                android:layout_weight="1"
                android:layout_margin="@dimen/vs_5"
                android:background="@drawable/bg_phone_card"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_12">

                <ImageView
                    android:layout_width="@dimen/vs_56"
                    android:layout_height="@dimen/vs_56"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:src="@drawable/icon_setting" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vs_6"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="设置"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_12"
        android:layout_marginBottom="@dimen/vs_6"
        android:gravity="left"
        android:text="热门推荐"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tvHotList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:visibility="gone" />
</LinearLayout>
