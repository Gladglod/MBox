<?xml version="1.0" encoding="utf-8"?>
<!--
  检查更新弹窗：
  顶部 = 下载图标 + 版本标题 + 版本号胶囊；
  中部 = 更新说明（限高可滚动）；
  底部 = 明确的两种更新方式「浏览器下载 / 软件内下载」，
         下载中就地把操作区切成进度 + 取消，不另开弹窗。
  面板沿用 dialog_panel_bg 玻璃材质，日间浅玻璃 / 夜间深玻璃自动切换。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 半透明蒙层：与确认弹窗同一套观感，突出前景卡片 -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <LinearLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <!-- 标题行：图标 | 发现新版本 + 当前版本 | 新版本号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_update_icon">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mine_download"
                    app:tint="@color/ui_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="发现新版本"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_30"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="@color/dialog_text_hint"
                    android:textSize="@dimen/ts_16"
                    tools:text="当前 2.2.3 · java64 版 · 安装包 34.6 MB" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersionTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_8"
                android:background="@drawable/bg_update_version_tag"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="96dp"
                android:paddingLeft="@dimen/vs_10"
                android:paddingTop="@dimen/vs_2"
                android:paddingRight="@dimen/vs_10"
                android:paddingBottom="@dimen/vs_2"
                android:textColor="@color/ui_accent"
                android:textSize="@dimen/ts_18"
                android:textStyle="bold"
                tools:text="v2.2.4" />
        </LinearLayout>

        <!-- 更新说明：下载时整块收起，把高度让给进度条，横屏也不至于超出屏幕 -->
        <LinearLayout
            android:id="@+id/notesBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_18"
            android:orientation="vertical">

            <!-- 更新说明标题 + 发布日期 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="更新内容"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_18"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPublishedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/dialog_text_hint"
                    android:textSize="@dimen/ts_14"
                    tools:text="2026-11-23 发布" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:background="@drawable/bg_update_notes"
                android:fadeScrollbars="false"
                android:lineSpacingMultiplier="1.25"
                android:maxHeight="120dp"
                android:maxLines="6"
                android:padding="@dimen/vs_12"
                android:scrollbars="vertical"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18"
                tools:text="优化播放器小窗落位\n修复部分设备全屏显示异常\n更新内置接口" />
        </LinearLayout>

        <!-- 下载进度：初始隐藏，点「软件内下载」后就地展开 -->
        <LinearLayout
            android:id="@+id/progressBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:background="@drawable/bg_update_notes"
            android:orientation="vertical"
            android:padding="@dimen/vs_12"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgressTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="正在下载"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_18"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vs_8"
                    android:maxLines="1"
                    android:text="0%"
                    android:textColor="@color/ui_accent"
                    android:textSize="@dimen/ts_18"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_4"
                android:layout_marginTop="@dimen/vs_8"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_update_bar" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="@color/dialog_text_hint"
                android:textSize="@dimen/ts_16"
                tools:text="下载中 12.3 MB / 34.6 MB（36%）" />
        </LinearLayout>

        <!-- 两种更新方式：浏览器自行下载 / 软件内直接下载安装 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBrowser"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_update_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="浏览器下载"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/bg_update_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="软件内下载"
                android:textColor="@color/ui_on_accent"
                android:textSize="@dimen/ts_20"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="软件内下载可直接安装；浏览器下载可自行保存安装包"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_14" />

        <!-- 底部轻量操作：稍后 / 忽略此版本 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLater"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="@dimen/vs_6"
                android:paddingBottom="@dimen/vs_6"
                android:text="稍后再说"
                android:textColor="@color/ui_text_tertiary"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/btnIgnore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="@dimen/vs_6"
                android:paddingBottom="@dimen/vs_6"
                android:text="忽略此版本"
                android:textColor="@color/ui_text_tertiary"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
