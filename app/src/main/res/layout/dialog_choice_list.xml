<?xml version="1.0" encoding="utf-8"?>
<!-- 通用单选列表对话框：站点选择、分类选择都用它 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/vs_60"
        android:layout_marginLeft="@dimen/vs_60"
        android:layout_marginEnd="@dimen/vs_60"
        android:layout_marginRight="@dimen/vs_60"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_24"
        android:paddingLeft="@dimen/vs_24"
        android:paddingTop="@dimen/vs_24"
        android:paddingEnd="@dimen/vs_24"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_12">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="@dimen/vs_12"
            android:overScrollMode="never"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/vs_100"
            android:text="@string/action_cancel"
            android:textColor="@color/ui_link"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</FrameLayout>
