<?xml version="1.0" encoding="utf-8"?>
<!-- 数据源下拉菜单的一行。左右各留 6dp，让背后的玻璃指示器能露出来包住它 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvSourceName"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_108"
    android:layout_marginStart="@dimen/vs_6"
    android:layout_marginLeft="@dimen/vs_6"
    android:layout_marginEnd="@dimen/vs_6"
    android:layout_marginRight="@dimen/vs_6"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/vs_12"
    android:paddingLeft="@dimen/vs_12"
    android:paddingEnd="@dimen/vs_12"
    android:paddingRight="@dimen/vs_12"
    android:singleLine="true"
    android:textColor="@color/ui_text_primary"
    android:textSize="@dimen/ts_18" />
