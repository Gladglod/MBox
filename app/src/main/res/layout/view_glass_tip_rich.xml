<?xml version="1.0" encoding="utf-8"?>
<!--
  富版玻璃轻提示（GlassTip.showRich）：图标 + 主标题 + 副标题。
  用于「弹幕已加载」这类需要交代上下文的成功反馈；
  bg_glass_pill 深玻璃胶囊，深浅内容上都保持可读。-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tvGlassTipRich"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingTop="8dp"
    android:paddingRight="18dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivGlassTipIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mine_danmu"
        app:tint="#F2FFFFFF" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGlassTipTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGlassTipSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
