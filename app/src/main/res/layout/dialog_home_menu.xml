<?xml version="1.0" encoding="utf-8"?>
<!--
  首页长按菜单：底部上滑面板。
  结构与 DownloadSelectDialog 一致：整屏透明窗口 + 可点蒙层 + 贴底面板，
  进出场用 View 级动画（translationY + alpha），不用 windowAnimations。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/discover_scrim"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/sheetPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_discover_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_20">

        <!-- 顶部指示条：底部面板的视觉标识，和详情浮层的圆角面板保持同一套语言 -->
        <View
            android:layout_width="@dimen/vs_60"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/vs_10"
            android:background="@drawable/bg_discover_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_2"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_8"
            android:text="@string/home_menu_title"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_14"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_14">

            <ImageView
                android:layout_width="@dimen/vs_100"
                android:layout_height="@dimen/vs_100"
                android:background="@drawable/bg_discover_icon_circle"
                android:importantForAccessibility="no"
                android:padding="@dimen/vs_24"
                android:src="@drawable/ic_discover"
                android:tint="@color/ui_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_14"
                android:layout_marginLeft="@dimen/vs_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_menu_discover"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ts_18"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_2"
                    android:text="@string/home_menu_discover_desc"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/vs_45"
                android:layout_height="@dimen/vs_45"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/ui_text_tertiary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_60"
            android:layout_marginEnd="@dimen/vs_12"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@color/ui_divider" />

        <LinearLayout
            android:id="@+id/rowTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_14"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_14">

            <ImageView
                android:layout_width="@dimen/vs_100"
                android:layout_height="@dimen/vs_100"
                android:background="@drawable/bg_discover_icon_circle"
                android:importantForAccessibility="no"
                android:padding="@dimen/vs_24"
                android:src="@drawable/ic_nav_category"
                android:tint="@color/ui_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_14"
                android:layout_marginLeft="@dimen/vs_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_menu_tabs"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ts_18"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_2"
                    android:text="@string/home_menu_tabs_desc"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/vs_45"
                android:layout_height="@dimen/vs_45"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/ui_text_tertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/vs_100"
            android:text="@string/home_menu_cancel"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:gravity="center"
            android:text="@string/home_menu_hint"
            android:textColor="@color/ui_text_tertiary"
            android:textSize="@dimen/ts_10" />
    </LinearLayout>
</FrameLayout>
