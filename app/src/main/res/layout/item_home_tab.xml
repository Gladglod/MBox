<?xml version="1.0" encoding="utf-8"?>
<!-- 首页分类页签：文字 + 可点开的细分筛选入口。没有筛选的分类不显示右侧图标 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/vs_8"
    android:paddingLeft="@dimen/vs_8"
    android:paddingEnd="@dimen/vs_8"
    android:paddingRight="@dimen/vs_8">

    <TextView
        android:id="@+id/tabLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ui_text_secondary"
        android:textSize="@dimen/ts_18" />

    <ImageView
        android:id="@+id/tabFilter"
        android:layout_width="@dimen/vs_28"
        android:layout_height="@dimen/vs_28"
        android:layout_marginStart="@dimen/vs_4"
        android:layout_marginLeft="@dimen/vs_4"
        android:clickable="true"
        android:contentDescription="@string/home_filter"
        android:importantForAccessibility="yes"
        android:padding="3dp"
        android:scaleType="centerInside"
        android:src="@drawable/icon_filter"
        android:tint="@color/ui_text_secondary"
        android:visibility="gone" />

</LinearLayout>
