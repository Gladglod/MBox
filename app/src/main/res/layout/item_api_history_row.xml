<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_12"
    android:paddingTop="@dimen/vs_10"
    android:paddingRight="@dimen/vs_8"
    android:paddingBottom="@dimen/vs_10">

    <TextView
        android:id="@+id/tvApi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textColor="@color/ui_text_primary"
        android:textSize="@dimen/ts_16" />

    <TextView
        android:id="@+id/tvCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_8"
        android:background="@drawable/bg_api_current_tag"
        android:paddingLeft="@dimen/vs_5"
        android:paddingTop="1dp"
        android:paddingRight="@dimen/vs_5"
        android:paddingBottom="1dp"
        android:text="当前"
        android:textColor="@color/ui_link"
        android:textSize="@dimen/ts_14"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivDel"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/icon_delete"
        android:tint="@color/ui_muted" />
</LinearLayout>
