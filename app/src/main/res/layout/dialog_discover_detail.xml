<?xml version="1.0" encoding="utf-8"?>
<!--
  发现页影片详情浮层。
  上面是海报 + 关键信息，中间简介 / 主演可滚动，底部固定两个动作：
  「在 TMDB 查看」和「搜索片源」。面板高度在代码里按屏幕 82% 封顶。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_discover_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/vs_20"
    android:paddingLeft="@dimen/vs_20"
    android:paddingTop="@dimen/vs_24"
    android:paddingEnd="@dimen/vs_20"
    android:paddingRight="@dimen/vs_20"
    android:paddingBottom="@dimen/vs_16">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ui_text_primary"
        android:textSize="@dimen/ts_34"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_4"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ui_text_secondary"
        android:textSize="@dimen/ts_14" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_14"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="132dp"
                    android:background="@drawable/bg_poster"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/ivPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vs_14"
                    android:layout_marginLeft="@dimen/vs_14"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_accent"
                        android:textSize="@dimen/ts_24"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGenres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_6"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="@dimen/ts_14" />

                    <TextView
                        android:id="@+id/tvRuntime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_4"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="@dimen/ts_14" />

                    <TextView
                        android:id="@+id/tvDirector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_4"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="@dimen/ts_14" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_4"
                        android:textColor="@color/ui_text_tertiary"
                        android:textSize="@dimen/ts_10" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_16"
                android:text="@string/discover_detail_overview"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/ts_18"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/tvCastLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_16"
                android:text="@string/discover_detail_cast"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/ts_18"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/ts_16"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_14"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTmdb"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_120"
            android:layout_marginEnd="@dimen/vs_8"
            android:layout_marginRight="@dimen/vs_8"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/discover_detail_tmdb"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_120"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/discover_detail_search"
            android:textColor="@color/ui_accent"
            android:textSize="@dimen/ts_16"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_6"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/vs_80"
        android:text="@string/discover_detail_close"
        android:textColor="@color/ui_text_tertiary"
        android:textSize="@dimen/ts_16" />
</LinearLayout>
