<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:tint="@color/ui_icon"
            android:src="@drawable/icon_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_8"
            android:text="播放历史"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_6"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_6"
            android:text="编辑"
            android:textColor="@color/ui_link"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_8"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_12" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="还没有观看记录"
            android:textColor="@color/ui_muted"
            android:textSize="@dimen/ts_18"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/ui_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="全选"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvDeleteSelected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="删除"
            android:textColor="@color/ui_danger"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvDone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="完成"
            android:textColor="@color/ui_link"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</LinearLayout>
