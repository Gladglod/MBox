<?xml version="1.0" encoding="utf-8"?>
<!-- 短剧源胶囊：一行里横向滚动，选中态靠描边 + 底色 + 文字色三重区分 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvChip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/vs_8"
    android:layout_marginRight="@dimen/vs_8"
    android:background="@drawable/bg_drama_chip"
    android:clickable="true"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center"
    android:maxWidth="@dimen/vs_400"
    android:minHeight="@dimen/vs_90"
    android:paddingStart="@dimen/vs_14"
    android:paddingLeft="@dimen/vs_14"
    android:paddingEnd="@dimen/vs_14"
    android:paddingRight="@dimen/vs_14"
    android:singleLine="true"
    android:textColor="@color/drama_chip_text"
    android:textSize="@dimen/ts_18" />
