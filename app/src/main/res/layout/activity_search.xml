<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部搜索栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_appbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_8"
        android:paddingLeft="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false"
            android:padding="@dimen/vs_10"
            android:src="@drawable/icon_back"
            android:tint="@android:color/white" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/vs_8"
            android:layout_marginLeft="@dimen/vs_8"
            android:layout_weight="1"
            android:background="@drawable/input_search"
            android:hint="搜索影视 / 演员"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:textColor="@android:color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/vs_8"
            android:layout_marginLeft="@dimen/vs_8"
            android:background="@drawable/bg_chip_selected"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:paddingStart="@dimen/vs_14"
            android:paddingLeft="@dimen/vs_14"
            android:paddingEnd="@dimen/vs_14"
            android:paddingRight="@dimen/vs_14"
            android:text="搜索"
            android:textColor="@color/color_02F8E1"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>

    <!-- 指定搜索源 / 清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <TextView
            android:id="@+id/tvSearchCheckboxBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:text="指定搜索源"
            android:textColor="@color/color_BBFFFFFF"
            android:textSize="@dimen/ts_16" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:paddingStart="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_12"
            android:paddingEnd="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:text="清空"
            android:textColor="@color/color_BBFFFFFF"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <!-- 热词 / 历史标题 + 横向词条 -->
    <LinearLayout
        android:id="@+id/llWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12">

        <TextView
            android:id="@+id/wordSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:clickable="true"
            android:focusable="false"
            android:text="热词 | 历史"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridViewWord"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/vs_6"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- 历史（聚合模式） -->
    <LinearLayout
        android:id="@+id/llHistoryWord"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_12"
        android:paddingTop="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/tvHistoryClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:padding="@dimen/vs_8"
                android:src="@drawable/icon_delete"
                android:tint="@color/color_BBFFFFFF" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/historyWordGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- 搜索结果 -->
    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_8"
        android:paddingLeft="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_8"
        android:paddingRight="@dimen/vs_8">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="invisible"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
