<?xml version="1.0" encoding="utf-8"?>
<!-- 弹幕开关按钮：打开态（iOS 玻璃胶囊底 + 青色描边指示开启） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <solid android:color="#59101418" />
            <stroke
                android:width="1dp"
                android:color="@color/color_02F8E1" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient
                android:angle="270"
                android:startColor="#1A02F8E1"
                android:endColor="#0002F8E1" />
        </shape>
    </item>
</layer-list>
