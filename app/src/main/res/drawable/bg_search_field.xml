<?xml version="1.0" encoding="utf-8"?>
<!--
  首页假搜索框。
  只靠填充色在白底顶栏上是分不出来的（#F0F1F5 vs #FFFFFF = 1.06:1），
  所以补一条 1dp 的 ui_divider 描边把边界画出来；按下时整块底色变深一档。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_divider" />
            <corners android:radius="@dimen/radius_20" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_divider" />
            <corners android:radius="@dimen/radius_20" />
        </shape>
    </item>
</selector>
