<?xml version="1.0" encoding="utf-8"?>
<!--
  快搜页顶部搜索状态胶囊底：
  主题玻璃（glass_row_* 随日/夜切换）——白天浅色玻璃配深字、夜间深色玻璃配白字，
  不再使用写死的深灰底（日间模式下主题深字压深底看不见）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/glass_row_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_row_stroke" />
    <corners android:radius="10mm" />
    <padding
        android:left="@dimen/vs_5"
        android:top="@dimen/vs_3"
        android:right="@dimen/vs_5"
        android:bottom="@dimen/vs_3" />
</shape>
