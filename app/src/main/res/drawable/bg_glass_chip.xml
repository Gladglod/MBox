<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 玻璃质感行条底（菜单列表项 / 设备行）：
  半透明深玻璃底 + 白细描边 + 顶部高光，与 bg_glass_circle / bg_glass_pill 同一套画法。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#4D10141A" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
