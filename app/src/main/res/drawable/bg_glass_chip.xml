<?xml version="1.0" encoding="utf-8"?>
<!--
  主题自适应玻璃行条底（菜单列表行 / 设备行）：
  半透明玻璃底 + 细描边 + 顶部高光，颜色引用 glass_row_* 主题色，
  日间白玻璃、夜间深玻璃。10dp 圆角。-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/glass_row_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_row_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
