<?xml version="1.0" encoding="utf-8"?>
<!--
  「指定搜索源」这类底部面板式弹窗的底。
  和 bg_sheet_panel 的区别：那张是播放页的深色浮层（始终深色），
  这张跟随弹窗调色板，日间浅色、夜间深色。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dialog_panel_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/dialog_panel_stroke" />
    <corners android:radius="18dp" />
</shape>
