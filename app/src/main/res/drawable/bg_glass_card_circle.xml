<?xml version="1.0" encoding="utf-8"?><!--
  主题玻璃圆形按钮底（浅色页面上的返回/筛选等圆钮）。
  与 bg_glass_card_pill 同一色系（glass_card_* 主题色，日=白玻璃/夜=深玻璃），
  但为正圆，供 40dp 方形视图做圆形图标钮。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_card_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
