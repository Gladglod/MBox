<?xml version="1.0" encoding="utf-8"?>
<!-- 播放设置抽屉内的下拉值条：比普通胶囊略实，保证日间白底上文字和边框仍清晰 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_menu_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_row_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_card_highlight"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
