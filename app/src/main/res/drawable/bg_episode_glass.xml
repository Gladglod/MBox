<?xml version="1.0" encoding="utf-8"?>
<!--
  选集面板：自适应玻璃底（引用 glass_card_* 主题色：
  日间白色透明玻璃、夜间深玻璃），细描边 + 大圆角，浮在画面上。-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_card_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_card_stroke" />
    <corners android:radius="18dp" />
</shape>
