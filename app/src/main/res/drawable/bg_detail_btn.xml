<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页操作按钮（收藏 / 换源 / 搜索 / 简介）：20dp 全圆角胶囊、中性玻璃底 + 1dp 描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ui_surface_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_menu_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ui_material_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_menu_stroke" />
        </shape>
    </item>
</selector>
