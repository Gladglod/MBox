<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 玻璃质感圆形按钮底：
  底层浇一层半透明深色「毛玻璃」面板，再叠一道自上而下的高光渐变模拟玻璃反射。
  使用场景：直播播放器上的悬浮操作钮（暂停 / 全屏 / 关闭）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#59101418" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
