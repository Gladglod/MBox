<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮：品牌色实底，按下时稍微加深 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_6" />
            <solid android:color="@color/ui_accent_pressed" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="@dimen/vs_6" />
            <solid android:color="@color/ui_accent_disabled" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_6" />
            <solid android:color="@color/ui_accent" />
        </shape>
    </item>
</selector>
