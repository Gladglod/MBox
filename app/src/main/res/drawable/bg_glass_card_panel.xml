<?xml version="1.0" encoding="utf-8"?><!--
  主题自适应玻璃对话框面板底（14dp 圆角）：
  与 bg_glass_group 同一结构，但颜色全部走 glass_card_* 主题色——
  白天主题自动变白色透明玻璃、夜间为深玻璃，无需两套布局。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/glass_card_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
