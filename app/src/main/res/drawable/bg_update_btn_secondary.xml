<?xml version="1.0" encoding="utf-8"?>
<!--
  更新弹窗次按钮（浏览器下载）：与主按钮同圆角，
  常态玻璃底、焦点品牌色描边、按下略微加深。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/ui_accent_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/ui_accent_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_accent" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/glass_row_fill" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_row_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/glass_card_highlight"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
