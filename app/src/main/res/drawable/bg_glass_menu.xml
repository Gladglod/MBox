<?xml version="1.0" encoding="utf-8"?>
<!--
  主题自适应玻璃菜单面板底（倍速 / 画面比例 / 数据源弹出列表等）：
  与 bg_glass_card_panel 同一套玻璃画法，但颜色全部引用 glass_menu_* 主题色：
  日间主题自动变白色透明玻璃、夜间为深玻璃，无需两套布局。
  四角均为 14dp 圆角。-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/glass_menu_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_menu_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
