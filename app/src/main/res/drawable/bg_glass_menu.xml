<?xml version="1.0" encoding="utf-8"?>
<!--
  右上角「数据源」下拉菜单的面板材质，和底部导航同一套玻璃语言，
  只是圆角小一档（16dp）—— 胶囊是导航的专属形态，菜单用常规大圆角才不会喧宾夺主。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_menu_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_menu_stroke" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_bar_highlight"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
