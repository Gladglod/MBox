<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 玻璃质感菜单面板底（倍速 / 画面比例弹出列表等）：
  与 bg_glass_sheet 同一套玻璃画法（半透明深底 + 白描边 + 顶部高光），四角均为 14dp 圆角。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#D9111418" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
