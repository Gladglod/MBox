<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 玻璃确认弹窗卡片底（ConfirmClearDialog 等居中式确认框）：
  四角大圆角 + 主题自适应玻璃填充（dialog_panel_bg：日间白玻璃 / 夜间深玻璃）
  + 细描边 + 顶部高光渐变，白天夜里都成立。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/dialog_panel_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/dialog_panel_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
