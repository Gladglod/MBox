<?xml version="1.0" encoding="utf-8"?>
<!--
  主题自适应玻璃行条底：选中态（玻璃底 + 主题强调色描边 + 微高光）。
  白天为深色强调色描边、夜间为青色描边；白色高光 gradient 结尾保持不变，
  用于倍速 / 画面比例菜单里当前项、投屏列表选中项等。-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/glass_row_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/ui_accent_soft"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
