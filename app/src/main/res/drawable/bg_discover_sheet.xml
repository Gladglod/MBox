<?xml version="1.0" encoding="utf-8"?>
<!--
  发现页 / 首页长按菜单的底部抽屉面板。
  顶部圆角 + 主题玻璃材质，结构和 bg_glass_menu 一致，只是圆角更大（22dp），
  让它更像从屏幕底边升起的面板，而不是一块悬浮卡片。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
            <solid android:color="@color/glass_menu_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_menu_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
