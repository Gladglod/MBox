<?xml version="1.0" encoding="utf-8"?>
<!-- 播放设置抽屉内的胶囊按钮：主题自适应玻璃行条，日间浅色 / 夜间深色 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_row_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_row_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_card_highlight"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
