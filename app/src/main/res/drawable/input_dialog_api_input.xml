<?xml version="1.0" encoding="utf-8"?><!--
  对话框玻璃输入框（接口地址 / 密码 / 数值等）。
  原版是矩形场域（无圆角、颜色写死旧主题）；升级为 10dp 圆角玻璃场域：
  常态 = dialog_input_bg 主题底 + 面板描边；
  焦点态 = 强调色描边，日夜主题自动切换。
  内缩 padding 保留（dialog_api 等布局依赖它提供文本边距）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="@dimen/vs_5" android:left="@dimen/vs_20_" android:right="@dimen/vs_20_" android:top="@dimen/vs_20_">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/dialog_control_stroke_focused" />
                    <solid android:color="@color/dialog_input_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="false">
        <layer-list>
            <item android:bottom="@dimen/vs_5" android:left="@dimen/vs_20_" android:right="@dimen/vs_20_" android:top="@dimen/vs_20_">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/dialog_panel_stroke" />
                    <solid android:color="@color/dialog_input_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
