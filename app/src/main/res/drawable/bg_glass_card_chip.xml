<?xml version="1.0" encoding="utf-8"?><!--
  主题自适应玻璃行条底（对话框列表项）：
  与 bg_glass_card_pill 同一色系，10dp 圆角；白天白玻璃行、夜间深玻璃行。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/glass_row_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_row_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
