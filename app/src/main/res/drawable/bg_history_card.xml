<?xml version="1.0" encoding="utf-8"?>
<!--
  播放历史 / 收藏列表的 iOS 玻璃卡片材质（比群组容器的 26dp 圆角收窄到 16dp）：
  1. 填充：半透明白（日）/ 半透明深色（夜，随 values-night），保持文字对比度
  2. 1dp 高光描边：空间压缩浅色勾边（夜间换暗边）
  3. 顶部高光渐变：模拟玻璃上缘反光
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_card_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_stroke" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_card_highlight"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
