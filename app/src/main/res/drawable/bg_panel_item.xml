<?xml version="1.0" encoding="utf-8"?>
<!--
  浅色面板里「一行一行的可选条目」的底色（节目单、直播设置抽屉共用）。
  聚焦 / 选中：淡强调色底 + 强调色描边；其余透明。
  原来的 shape_live_focus 聚焦是整块纯蓝 + 白字，那是给深色播放器做的，
  铺到白色面板上白字会直接消失。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_accent_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_accent_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
