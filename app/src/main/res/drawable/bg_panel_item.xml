<?xml version="1.0" encoding="utf-8"?>
<!--
  浅色面板里「一行一行的可选条目」的底色（节目单、直播设置抽屉共用）。
  聚焦 / 选中：淡强调色底 + 强调色描边；其余透明。
  原来的 shape_live_focus 聚焦是整块纯蓝 + 白字，那是给深色播放器做的，
  铺到白色面板上白字会直接消失。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_panel_item_focused" />
    <item android:state_selected="true" android:drawable="@drawable/bg_panel_item_focused" />
    <item android:drawable="@android:color/transparent" />
</selector>
