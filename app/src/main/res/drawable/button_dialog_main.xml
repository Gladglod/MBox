<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗里的主按钮：跟随弹窗调色板（日间浅底深字，夜间深底白字） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_5" />
            <solid android:color="@color/dialog_control_bg_focused" />
            <stroke
                android:width="@dimen/vs_1"
                android:color="@color/dialog_control_stroke_focused" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_5" />
            <solid android:color="@color/dialog_control_bg" />
            <stroke
                android:width="@dimen/vs_1"
                android:color="@color/dialog_control_stroke" />
        </shape>
    </item>
</selector>
