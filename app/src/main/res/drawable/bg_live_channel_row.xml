<?xml version="1.0" encoding="utf-8"?>
<!--
  直播频道行卡片：
  常态：播放历史同款 iOS 玻璃卡片（bg_history_card，日夜色随 values-night）；
  选中 / 聚焦：强调色描边 + 浅强调色填充，和「选集」「播放源」的选中语言一致。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_chip_selected" android:state_focused="true" />
    <item android:drawable="@drawable/bg_chip_selected" android:state_selected="true" />
    <item android:drawable="@drawable/bg_history_card" />
</selector>
